.DS_Store
__pycache__/

# Made from each shader build's outputs (c1_guard.py, cb_extent.py), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv

# coverage.py data and its JSON report (pyproject.toml, [tool.coverage.run])
.coverage
.coverage.*
/coverage.json

# Kate AI writes this graph for its project tools
.kateai/project_graph.json

# Build output directories, at any depth (CMake/Ninja, IDE, packaging).
# A source file such as build.sh is not a directory and is not ignored.
build/
build-*/
build_*/
cmake-build-*/
out/
dist/
games/
games/*
